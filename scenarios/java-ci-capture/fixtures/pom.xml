<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Maven project reproducing the "CI integration tests (Maven Failsafe)"
  recipe from the upstream docs/INSTRUMENTATION.md, Option 1 (`perf-sentinel
  capture`).

  The maven-dependency-plugin and maven-failsafe-plugin blocks below are copied
  VERBATIM from that section. If the recipe drifts, this file must be updated to
  match it, never the other way round: the point of the scenario is to run what
  the documentation actually tells users to run.

  One indirection: the OTLP endpoint is a property whose DEFAULT is the
  documented literal `http://localhost:4317`. Leg D0 runs with that default, so
  it exercises the recipe exactly as published; the later legs override it, to
  measure the rest of the capture contract independently of D0's outcome.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.perfsim.lab</groupId>
  <artifactId>java-ci-capture-it</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The documented argLine uses @{argLine}, the late-replacement placeholder
         a JaCoCo-style plugin fills in. Declared empty so the recipe can be
         pasted verbatim into a project that has no such plugin. -->
    <argLine></argLine>
    <!-- The documented value. verify.sh overrides it only where a leg needs a
         configuration that actually exports. -->
    <lab.otel.endpoint>http://localhost:4317</lab.otel.endpoint>
    <!-- The documented value. The recipe now states the protocol rather than
         relying on the agent default, which moved from grpc to http/protobuf in
         agent 2.0 — the same endpoint then means a different port. -->
    <lab.otel.protocol>grpc</lab.otel.protocol>
    <lab.items>15</lab.items>
    <lab.db.url></lab.db.url>
    <lab.fail></lab.fail>
    <junit.version>5.11.4</junit.version>
    <postgresql.version>42.7.4</postgresql.version>
    <!-- Older than the agent on purpose: the javaagent bridges API versions at
         or below its own, never above. -->
    <opentelemetry-api.version>1.40.0</opentelemetry-api.version>
    <failsafe.version>3.5.0</failsafe.version>
    <!-- Pinned because Maven's super-POM binds a compiler plugin old enough to
         predate `maven.compiler.release`, and it then silently falls back to
         source/target 5. Which version you get depends on the Maven the runner
         ships, so an unpinned build passes on a developer machine and fails on
         a CI image. -->
    <compiler-plugin.version>3.15.0</compiler-plugin.version>
    <dependency-plugin.version>3.8.1</dependency-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Only used to open the SERVER span that stands in for the one a web
         framework would create. The JDBC spans themselves come from the agent. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry-api.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
      </plugin>

      <!-- Copy the agent jar into target/ before the integration-test phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>copy-otel-agent</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.opentelemetry.javaagent</groupId>
                  <artifactId>opentelemetry-javaagent</artifactId>
                  <version>2.27.0</version> <!-- match the version baked into your Dockerfile -->
                  <destFileName>opentelemetry-javaagent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Add -javaagent to the EXISTING failsafe argLine, do not replace it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${failsafe.version}</version>
        <configuration>
          <argLine>@{argLine} -javaagent:${project.build.directory}/opentelemetry-javaagent.jar</argLine>
          <environmentVariables>
            <OTEL_TRACES_EXPORTER>otlp</OTEL_TRACES_EXPORTER>
            <OTEL_EXPORTER_OTLP_ENDPOINT>${lab.otel.endpoint}</OTEL_EXPORTER_OTLP_ENDPOINT>
            <OTEL_EXPORTER_OTLP_PROTOCOL>${lab.otel.protocol}</OTEL_EXPORTER_OTLP_PROTOCOL>
            <OTEL_SERVICE_NAME>lab-java-it</OTEL_SERVICE_NAME>
            <OTEL_TRACES_SAMPLER>always_on</OTEL_TRACES_SAMPLER>
            <OTEL_METRICS_EXPORTER>none</OTEL_METRICS_EXPORTER>
            <OTEL_LOGS_EXPORTER>none</OTEL_LOGS_EXPORTER>
            <!-- Not part of the documented recipe, and kept for DETERMINISM
                 rather than for correctness. Measured on this fixture: with the
                 sanitizer on, perf-sentinel's default `auto` mode still reports
                 n_plus_one_sql, via the recovery heuristic
                 (classification_method=sanitizer_heuristic). But this project is
                 plain JDBC with no ORM scope marker, so that heuristic rests on
                 timing variance alone — and at 10 occurrences instead of 15,
                 `strict` already falls back to redundant_sql. A gate assertion
                 must not depend on how loaded the machine was. Off here, the
                 literals stay distinct and the standard distinct_params rule
                 decides, with no heuristic in the loop.
                 Do NOT read this as advice to disable the sanitizer in a real
                 pipeline: it puts raw SQL literals into a trace file that CI
                 commonly publishes as a job artifact, and `auto` does not need
                 it. -->
            <OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED>false</OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED>
            <LAB_DB_URL>${lab.db.url}</LAB_DB_URL>
            <LAB_ITEMS>${lab.items}</LAB_ITEMS>
            <LAB_FAIL>${lab.fail}</LAB_FAIL>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The no-capture shape: the agent in the Failsafe fork writes OTLP JSON
         Lines straight to target/traces.jsonl, no receiver, no port, no stdout.
         Needs OpenTelemetry Java SDK 1.66.0 (open-telemetry/opentelemetry-java
         #8676, `output_stream` on `otlp_file/development`), which only
         declarative configuration reaches: there is no OTEL_* variable for it.
         Agent 2.31.1 bundles SDK 1.65 and silently writes to stdout instead;
         2.32.0 is the first agent with 1.66. Renovate's maven manager is off
         in this repo, so this pin moves by hand. -->
    <profile>
      <id>otel-file</id>
      <properties>
        <lab.otel.file.agent.version>2.32.0</lab.otel.file.agent.version>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-otel-agent</id>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>io.opentelemetry.javaagent</groupId>
                      <artifactId>opentelemetry-javaagent</artifactId>
                      <version>${lab.otel.file.agent.version}</version>
                      <destFileName>opentelemetry-javaagent.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <!-- target/ survives between runs: without this the copy
                       skips a jar that is already there, whatever its version. -->
                  <overWriteReleases>true</overWriteReleases>
                  <overWriteSnapshots>true</overWriteSnapshots>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <environmentVariables>
                <!-- With a config file set, the agent reads that file and
                     nothing else: the OTEL_* variables above no longer apply. -->
                <OTEL_CONFIG_FILE>${project.basedir}/otel-file.yaml</OTEL_CONFIG_FILE>
                <LAB_TRACES_FILE>${project.build.directory}/traces.jsonl</LAB_TRACES_FILE>
              </environmentVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
