<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.perfsim</groupId>
    <artifactId>services-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>perf-sentinel simulation lab services</name>
    <description>Aggregator pom for the three Spring Boot services that exercise perf-sentinel detectors.</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <modules>
        <module>shared-config</module>
        <module>order-service</module>
        <module>payment-service</module>
        <module>notification-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Boot 4.1.2 manages Flyway 12.4.0 and amqp-client 5.30.0: pin the latest stable. -->
        <flyway.version>13.12.1</flyway.version>
        <rabbit-amqp-client.version>5.37.1</rabbit-amqp-client.version>
        <!-- OTel API bundled by the javaagent 2.33.1 (Boot manages 1.62.0); keep it no newer than the agent's. -->
        <opentelemetry.version>1.67.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.perfsim</groupId>
                <artifactId>shared-config</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
