{
  // shortcut: TypeScript stays on 6.0.x, TS 7 is the Go-native compiler and breaks
  // the TS-API tooling (nest build, @nestjs/schematics peer ^6), upgrade once Nest supports 7.
  // nodenext without "type": "module" emits CommonJS that loads the ESM-only Nest 12
  // packages through require(esm), keeping the OTel require-hooks (http, pg) effective.
  "compilerOptions": {
    "module": "nodenext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2024",
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*"]
}
