{
  "name": "nest-svc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:messaging-negative": "npm run prisma:generate && npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "amqplib": "2.3.1",
    "axios": "1.21.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3"
  }
}
