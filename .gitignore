# JetBrains
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Lab runtime artifacts
tmp/
*.log
kubeconfig*
.kube-config-perf-sentinel-lab
# CNI marker written by scripts/install-cni.sh (cilium or calico)
cluster/.cni-active

# Secrets generated at bootstrap
.postgres-password
.postgres-*-password
.rabbitmq-password
.perf-sentinel-hub-import-key
.electricity-maps-token
*.pem
*.key
*.crt

# Helm packaged charts
charts/*.tgz

# Maven build artifacts
services/**/target/
services/**/*.iml
.mvn/wrapper/maven-wrapper.jar

# .NET and Node build artifacts
services/**/bin/
services/**/obj/
services/**/node_modules/

# Editor swap files
*.swp
*.swo
*~

# Brainstorming / design specs stay local, not committed.
docs/superpowers/

# Visual proof artifacts produced by make capture-greenops-screenshot
# (PNG, HTML, Chrome logs) stay untracked. `artifacts/fixtures/` is the
# exception: it carries the GitLab CI template test project fixtures
# and must stay versioned. Tracked extensions are .json, .toml, .yml,
# .yaml — adding a new fixture in one of those formats is automatically
# picked up by git, no .gitignore edit required.
artifacts/*
!artifacts/fixtures/
artifacts/fixtures/*
!artifacts/fixtures/*.json
!artifacts/fixtures/*.toml
!artifacts/fixtures/*.yml
!artifacts/fixtures/*.yaml
scenarios/ci-e2e-jenkins/fixtures/project/

# Local tool output, never committed
__pycache__/

# PHP dependencies installed by `composer install` (and by Renovate's
# lockfile jobs in CI). rails-svc has its own rule in services/rails-svc/.gitignore.
services/*-svc/vendor/
