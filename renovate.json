{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":maintainLockFilesWeekly"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "dependencyDashboard": true,
  "logLevelRemap": [
    { "matchMessage": "/^(Error obtaining docker token|No docker auth found)/", "newLogLevel": "debug" }
  ],
  "kubernetes": { "managerFilePatterns": ["/manifests/.+\\.yaml$/"] },
  "helm-values": { "managerFilePatterns": ["/helm/values/.+\\.yaml$/"] },
  "customManagers": [
    {
      "customType": "regex",
      "description": "kube-prometheus-stack Helm chart version in bootstrap.sh",
      "managerFilePatterns": ["/^scripts/bootstrap\\.sh$/"],
      "matchStrings": ["KPS_CHART_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "kube-prometheus-stack",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://prometheus-community.github.io/helm-charts"
    },
    {
      "customType": "regex",
      "description": "opentelemetry-collector Helm chart version in bootstrap.sh",
      "managerFilePatterns": ["/^scripts/bootstrap\\.sh$/"],
      "matchStrings": ["OTEL_CHART_VERSION=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "opentelemetry-collector",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://open-telemetry.github.io/opentelemetry-helm-charts"
    },
    {
      "customType": "regex",
      "description": "Cilium Helm chart version in install-cni.sh and hubble-ui.sh",
      "managerFilePatterns": ["/^scripts/install-cni\\.sh$/", "/^scripts/hubble-ui\\.sh$/"],
      "matchStrings": ["CILIUM_VERSION=\"(?<currentValue>[^\"]+)\"", "--version (?<currentValue>1\\.\\d+\\.\\d+)"],
      "depNameTemplate": "cilium",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://helm.cilium.io"
    },
    {
      "customType": "regex",
      "description": "Calico tigera-operator Helm chart version in install-cni.sh",
      "managerFilePatterns": ["/^scripts/install-cni\\.sh$/"],
      "matchStrings": ["--version (?<currentValue>v3\\.\\d+\\.\\d+)"],
      "depNameTemplate": "tigera-operator",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://docs.tigera.io/calico/charts"
    },
    {
      "customType": "regex",
      "description": "k3d release tag in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["K3D_TAG:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "k3d-io/k3d",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm CLI version passed to azure/setup-helm in GitHub workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": ["version:\\s*'(?<currentValue>v\\d+\\.\\d+\\.\\d+)'"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Out of scope: custom-service application dependency managers",
      "matchManagers": ["npm", "nuget", "gradle", "maven", "maven-wrapper", "cargo", "gomod", "pip_requirements", "poetry", "composer", "bundler"],
      "enabled": false
    },
    {
      "description": "perf-sentinel and its Hub are the product under test, pinned by hand at each release; never propose updates for them",
      "matchPackageNames": ["ghcr.io/institut-du-numerique-responsable/perf-sentinel", "ghcr.io/institut-du-numerique-responsable/perf-sentinel-hub"],
      "enabled": false
    },
    {
      "description": "No major bumps on kubernetes-managed workload images, incl. grafana/tempo v3. Lab is version-sensitive (the Tempo manifest is hand-written for v2); held here and bumped manually when adapted.",
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Hold helm/helm major (v4): isolated, non-automerged, labeled",
      "matchPackageNames": ["helm/helm"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-review"]
    },
    {
      "description": "Observability charts group (non-major only)",
      "matchPackageNames": ["kube-prometheus-stack", "opentelemetry-collector", "grafana/tempo"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "observability charts"
    },
    {
      "description": "Cluster tooling group (non-major only)",
      "matchPackageNames": ["k3d-io/k3d", "helm/helm", "cilium", "tigera-operator"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "cluster tooling"
    }
  ]
}
